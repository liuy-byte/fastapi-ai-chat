# 复制成 .env 再改。.env 已在 .gitignore 里，不会被提交

# 生成一个：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

DATABASE_URL=mysql+aiomysql://chat:chat@127.0.0.1:3306/ai_chat?charset=utf8mb4

# 任何 OpenAI 兼容接口都行。下面是 DeepSeek 官方接口
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# 没有 key 时设成 true，用假模型复述你的话，流程照样能跑通
LLM_FAKE=false
